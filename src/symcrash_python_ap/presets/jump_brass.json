{
  "instrument_ir_v0": {
    "meta": {
      "instrument_id": "classic_07",
      "name": "Jump Brass",
      "version": 1,
      "author": "symcrash",
      "seed_u32": 0,
      "voice_model": { "max_voices": 8, "tile_size": 16 }
    },
    "io": {
      "sample_rate_hz": 48000,
      "block_size": 64
    },
    "layers": {
      "L0_graph": {
        "macros": [],
        "nodes": [
          { "id": "osc1", "type": "Osc", "params": { "waveform": "saw" } },
          { "id": "osc2", "type": "Osc", "params": { "waveform": "pulse", "pw": 0.5 } },
          { "id": "amp", "type": "Amp", "params": { "adsr": { "a_ms": 1, "d_ms": 80, "s": 0.6, "r_ms": 100 } } }
        ],
        "edges": [
          { "src": "osc1", "dst": "amp" },
          { "src": "osc2", "dst": "amp" }
        ]
      },
      "L3_cmmm": {
        "emit_templates": {
          "Stable": {
            "ops_enable": ["TILT", "COMPRESS_K", "DIFFUSE_DOWN"],
            "families": { "TILT": 0.45, "COMPRESS_K": 0.50, "DIFFUSE_DOWN": 0.30 },
            "events": [
              {
                "lane": "EVT_OP_PULSE",
                "condition": "block_index % 1 == 0",
                "payload_template": { "op": "IMPULSE" },
                "strength": "0.9"
              },
              {
                "lane": "EVT_OP_TOGGLE",
                "condition": "block_index % 8 == 0",
                "payload_template": { "op": "GLOBAL_PULSE" },
                "strength": "0.4"
              }
            ]
          }
        }
      }
    },
    "compile": {
      "completion_policy": { "default_tree": { "A": "T1", "B": "T1", "beta": 0.0 } }
    }
  }
}
